<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.beatify.view.controller.PlayerController"
           prefWidth="1280.0"
           prefHeight="800.0"
           style="-fx-background-color: #0a1628;">


    <VBox spacing="20" alignment="CENTER">
        <Label text="REPRODUCTOR EXPANDIDO"
               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-family: 'Sora';"/>
        <Label text="En construcción - Prueba de navegación"
               style="-fx-text-fill: #8da3bd; -fx-font-size: 14px;"/>
        <Button fx:id="btnVolver" text="← Volver al Home"
                onAction="#onVolver"
                style="-fx-background-color: #b794ff; -fx-text-fill: #0a1628; -fx-padding: 10 20; -fx-background-radius: 20;"/>
    </VBox>

</StackPane>
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- resenas.fxml — layout Spotify: sidebar full-height + main(topbar+contenido) + miniplayer -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.beatify.view.controller.ResenasController"
      prefWidth="1280.0" prefHeight="800.0">

    <HBox VBox.vgrow="ALWAYS">

        <!-- SIDEBAR -->
        <VBox styleClass="bf-sidebar" prefWidth="240" minWidth="240" spacing="2">
            <Label text="beatify" styleClass="bf-logo"/>
            <Label text="PRINCIPAL" styleClass="bf-side-divider"/>
            <Button text="Inicio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrInicio">
                <graphic><FontIcon iconLiteral="bi-house" iconSize="16"/></graphic>
            </Button>
            <Button text="Explorar" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrExplorar">
                <graphic><FontIcon iconLiteral="bi-search" iconSize="16"/></graphic>
            </Button>
            <Button text="Tu biblioteca" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBiblioteca">
                <graphic><FontIcon iconLiteral="bi-collection" iconSize="16"/></graphic>
            </Button>

            <Label text="DIFERENCIADORES" styleClass="bf-side-divider"/>
            <Button text="Reseñas" styleClass="bf-side-item, is-active" maxWidth="Infinity" onAction="#onIrResenas">
                <graphic><FontIcon iconLiteral="bi-star" iconSize="16"/></graphic>
            </Button>
            <Button text="Música del Barrio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBarrio">
                <graphic><FontIcon iconLiteral="bi-geo-alt" iconSize="16"/></graphic>
            </Button>
            <Button text="Cápsulas del Tiempo" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrCapsulas">
                <graphic><FontIcon iconLiteral="bi-clock" iconSize="16"/></graphic>
            </Button>
            <Button text="Logros" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrLogros">
                <graphic><FontIcon iconLiteral="bi-trophy" iconSize="16"/></graphic>
            </Button>

            <HBox styleClass="bf-side-divider" alignment="CENTER_LEFT">
                <Label text="TUS PLAYLISTS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button styleClass="bf-side-plus" onAction="#onNuevaPlaylist">
                    <graphic><FontIcon iconLiteral="bi-plus" iconSize="16" iconColor="#a7a7a7"/></graphic>
                </Button>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="sidebarPlaylistsBox" spacing="2"/>
            </ScrollPane>

            <Button text="Perfil" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrPerfil">
                <graphic><FontIcon iconLiteral="bi-person" iconSize="16" iconColor="#a7a7a7"/></graphic>
            </Button>
            <Region VBox.vgrow="SOMETIMES" minHeight="8"/>
            <Button text="Cerrar sesión" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onCerrarSesion">
                <graphic><FontIcon iconLiteral="bi-box-arrow-right" iconSize="16"/></graphic>
            </Button>
        </VBox>

        <!-- MAIN -->
        <VBox HBox.hgrow="ALWAYS">
            <HBox styleClass="bf-topbar" alignment="CENTER_LEFT">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button styleClass="bf-tb-arrow" onAction="#onAtras">
                        <graphic><FontIcon iconLiteral="bi-arrow-left" iconSize="14"/></graphic>
                    </Button>
                    <Button styleClass="bf-tb-arrow" onAction="#onAdelante">
                        <graphic><FontIcon iconLiteral="bi-arrow-right" iconSize="14"/></graphic>
                    </Button>
                </HBox>
                <HBox styleClass="bf-search" spacing="10" alignment="CENTER_LEFT" prefWidth="380" minWidth="280">
                    <FontIcon iconLiteral="bi-search" iconSize="14" iconColor="#a7a7a7"/>
                    <TextField fx:id="txtBusqueda" styleClass="bf-search-input"
                               promptText="Busca canciones, artistas, álbumes, podcasts..."
                               onAction="#onBuscar" HBox.hgrow="ALWAYS"/>
                    <Label text="Ctrl+K" styleClass="bf-search-hint"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <StackPane>
                        <Button fx:id="btnNotif" styleClass="bf-tb-icon" onAction="#onNotif">
                            <graphic><FontIcon iconLiteral="bi-bell" iconSize="16"/></graphic>
                        </Button>
                        <Label fx:id="lblNotifCount" text="5" styleClass="bf-tb-dot" StackPane.alignment="TOP_RIGHT">
                            <StackPane.margin><Insets top="2" right="2"/></StackPane.margin>
                        </Label>
                    </StackPane>
                    <Button fx:id="btnUserMenu" styleClass="bf-tb-user" onAction="#onUserMenu">
                        <graphic>
                            <HBox alignment="CENTER">
                                <StackPane fx:id="userAvatarHolder"/>
                                <Label fx:id="lblUserNombre" text="Usuario" visible="false" managed="false"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: -bf-bg; -fx-background: -bf-bg;">
                <VBox styleClass="bf-page" spacing="28">
                    <VBox spacing="8">
                        <Label text="FUNCIONALIDAD DISTINTIVA #1" styleClass="bf-section-eyebrow"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="bi-star-fill" iconSize="24" iconColor="#1ed760"/>
                            <Label text="Reseñas Musicales" styleClass="bf-page-title"/>
                        </HBox>
                        <Label text="Califica canciones, álbumes y artistas. Tu calificación promedio se actualiza automáticamente." styleClass="bf-page-meta" wrapText="true"/>
                    </VBox>

                    <HBox spacing="24">
                        <VBox spacing="8" styleClass="bf-card" alignment="CENTER" prefWidth="220">
                            <Label fx:id="lblTotalResenas" text="—" styleClass="bf-page-title"/>
                            <Label text="reseñas escritas" styleClass="bf-field-lbl"/>
                        </VBox>
                        <VBox spacing="8" styleClass="bf-card" alignment="CENTER" prefWidth="220">
                            <Label fx:id="lblPromedioDado" text="—" styleClass="bf-page-title"/>
                            <Label text="estrellas en promedio" styleClass="bf-field-lbl"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="segmented-control">
                        <ToggleButton fx:id="tabTodas" text="Todas" styleClass="seg-btn"/>
                        <ToggleButton fx:id="tabCancion" text="Canciones" styleClass="seg-btn"/>
                        <ToggleButton fx:id="tabAlbum" text="Álbumes" styleClass="seg-btn"/>
                        <ToggleButton fx:id="tabArtista" text="Artistas" styleClass="seg-btn"/>
                    </HBox>

                    <VBox spacing="16">
                        <Label text="Mis reseñas" styleClass="bf-section-title"/>
                        <VBox fx:id="listaResenasBox" spacing="12"/>
                    </VBox>

                    <VBox spacing="16" styleClass="bf-card">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="bi-pencil-square" iconSize="18" iconColor="#1ed760"/>
                            <Label text="Escribir nueva reseña" styleClass="bf-section-title"/>
                        </HBox>

                        <!-- Selección: tipo + objetivo por nombre + calificación -->
                        <HBox spacing="14" alignment="BOTTOM_LEFT">
                            <VBox spacing="6">
                                <Label text="Tipo" styleClass="bf-field-lbl"/>
                                <ComboBox fx:id="cmbTipo" prefWidth="150" styleClass="bf-combo"/>
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="¿Qué quieres reseñar?" styleClass="bf-field-lbl"/>
                                <ComboBox fx:id="cmbObjetivo" maxWidth="Infinity" styleClass="bf-combo"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label text="Calificación" styleClass="bf-field-lbl"/>
                                <Spinner fx:id="spnCalificacion" prefWidth="100" styleClass="bf-spinner"/>
                            </VBox>
                        </HBox>

                        <!-- Atajo: reseñar la canción que está sonando -->
                        <Button fx:id="btnUsarActual" styleClass="bf-btn-ghost" onAction="#onUsarCancionActual">
                            <graphic>
                                <HBox spacing="8" alignment="CENTER">
                                    <FontIcon iconLiteral="bi-music-note-beamed" iconSize="14" iconColor="white"/>
                                    <Label text="Usar la canción que suena" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Interno: id resuelto del objetivo seleccionado -->
                        <TextField fx:id="txtIdObjetivo" visible="false" managed="false"/>

                        <VBox spacing="6">
                            <Label text="Comentario" styleClass="bf-field-lbl"/>
                            <TextArea fx:id="txtComentario" prefRowCount="4" wrapText="true"
                                      promptText="¿Qué te pareció?" styleClass="bf-textarea"/>
                        </VBox>

                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <Label fx:id="lblFeedback" text="" styleClass="bf-field-lbl"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Limpiar" onAction="#onLimpiar" styleClass="bf-btn-ghost"/>
                            <Button text="Publicar" onAction="#onPublicar" styleClass="bf-btn-primary"/>
                        </HBox>
                    </VBox>

                    <Region prefHeight="32"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </HBox>

    <fx:include source="miniplayer.fxml"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beatify.view.controller.ResenasController"
            prefWidth="1280.0"
            prefHeight="800.0">
    <!-- TOPBAR (igual a las otras) -->
    <top>
        <HBox styleClass="bf-topbar" spacing="14" alignment="CENTER_LEFT">
            <HBox spacing="6">
                <Button styleClass="bf-tb-arrow" onAction="#onAtras">
                    <graphic><FontIcon iconLiteral="bi-arrow-left" iconSize="14"/></graphic>
                </Button>
                <Button styleClass="bf-tb-arrow" onAction="#onAdelante">
                    <graphic><FontIcon iconLiteral="bi-arrow-right" iconSize="14"/></graphic>
                </Button>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane>
                <Button fx:id="btnNotif" styleClass="bf-tb-icon" onAction="#onIrNotificaciones">
                    <graphic><FontIcon iconLiteral="bi-bell" iconSize="16"/></graphic>
                </Button>
                <Label fx:id="lblNotifCount" text="5" styleClass="bf-tb-dot" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="2" right="2"/></StackPane.margin>
                </Label>
            </StackPane>
            <Button fx:id="btnUserMenu" styleClass="bf-tb-user" onAction="#onUserMenu">
                <graphic>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <StackPane fx:id="userAvatarHolder"/>
                        <Label fx:id="lblUserNombre" text="Usuario"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- SIDEBAR (igual a las otras) -->
    <left>
        <VBox styleClass="bf-sidebar" prefWidth="240" spacing="2">
            <Label text="PRINCIPAL" styleClass="bf-side-divider"/>
            <Button text="Inicio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrInicio">
                <graphic><FontIcon iconLiteral="bi-house" iconSize="16"/></graphic>
            </Button>
            <Button text="Explorar" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrExplorar">
                <graphic><FontIcon iconLiteral="bi-search" iconSize="16"/></graphic>
            </Button>
            <Button text="Tu biblioteca" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBiblioteca">
                <graphic><FontIcon iconLiteral="bi-collection" iconSize="16"/></graphic>
            </Button>
            <Label text="DIFERENCIADORES" styleClass="bf-side-divider"/>
            <Button text="Reseñas" styleClass="bf-side-item, is-active" maxWidth="Infinity" onAction="#onIrResenas">
                <graphic><FontIcon iconLiteral="bi-star" iconSize="16"/></graphic>
            </Button>
            <Button text="Música del Barrio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBarrio">
                <graphic><FontIcon iconLiteral="bi-geo-alt" iconSize="16"/></graphic>
            </Button>
            <Button text="Cápsulas del Tiempo" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrCapsulas">
                <graphic><FontIcon iconLiteral="bi-clock" iconSize="16"/></graphic>
            </Button>
            <Button text="Logros" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrLogros">
                <graphic><FontIcon iconLiteral="bi-trophy" iconSize="16"/></graphic>
            </Button>
            <HBox styleClass="bf-side-divider" alignment="CENTER_LEFT">
                <Label text="TUS PLAYLISTS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button styleClass="bf-side-plus" onAction="#onNuevaPlaylist">
                    <graphic><FontIcon iconLiteral="bi-plus" iconSize="14"/></graphic>
                </Button>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="sidebarPlaylistsBox" spacing="2"/>
            </ScrollPane>
            <Region VBox.vgrow="SOMETIMES" minHeight="8"/>
            <Button text="Cerrar sesión" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onCerrarSesion">
                <graphic><FontIcon iconLiteral="bi-box-arrow-right" iconSize="16"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: -bf-bg; -fx-background: -bf-bg;">
            <VBox styleClass="bf-page" spacing="28">
                <!-- HEADER -->
                <VBox spacing="8">
                    <Label text="FUNCIONALIDAD DISTINTIVA #1" styleClass="bf-section-eyebrow"/>
                    <Label text="📝 Reseñas Musicales" styleClass="bf-page-title"/>
                    <Label text="Califica canciones, álbumes y artistas. Tu calificación promedio se calcula desde PKG_RESENAS.CALCULAR_PROMEDIO." styleClass="bf-page-meta" wrapText="true"/>
                </VBox>

                <!-- CARDS DE RESUMEN -->
                <HBox spacing="24">
                    <VBox spacing="8" styleClass="bf-card" alignment="CENTER" prefWidth="220">
                        <Label fx:id="lblTotalResenas" text="—" styleClass="bf-page-title"/>
                        <Label text="reseñas escritas" styleClass="bf-field-lbl"/>
                    </VBox>
                    <VBox spacing="8" styleClass="bf-card" alignment="CENTER" prefWidth="220">
                        <Label fx:id="lblPromedioDado" text="—" styleClass="bf-page-title"/>
                        <Label text="estrellas en promedio" styleClass="bf-field-lbl"/>
                    </VBox>
                </HBox>

                <!-- FILTROS POR TIPO -->
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="segmented-control">
                    <ToggleButton fx:id="tabTodas" text="Todas" styleClass="seg-btn"/>
                    <ToggleButton fx:id="tabCancion" text="Canciones" styleClass="seg-btn"/>
                    <ToggleButton fx:id="tabAlbum" text="Álbumes" styleClass="seg-btn"/>
                    <ToggleButton fx:id="tabArtista" text="Artistas" styleClass="seg-btn"/>
                </HBox>

                <!-- LISTA DE RESEÑAS -->
                <VBox spacing="16">
                    <Label text="Mis reseñas" styleClass="bf-section-title"/>
                    <VBox fx:id="listaResenasBox" spacing="12"/>
                </VBox>

                <!-- FORM DE NUEVA RESEÑA -->
                <VBox spacing="16" styleClass="bf-card">
                    <Label text="✍️ Escribir nueva reseña" styleClass="bf-section-title"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Tipo" styleClass="bf-field-lbl"/>
                            <ComboBox fx:id="cmbTipo" prefWidth="140" styleClass="bf-field-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="ID del objetivo" styleClass="bf-field-lbl"/>
                            <TextField fx:id="txtIdObjetivo" prefWidth="120" promptText="123" styleClass="bf-field-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Calificación" styleClass="bf-field-lbl"/>
                            <Spinner fx:id="spnCalificacion" prefWidth="80" styleClass="bf-field-input"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="Comentario" styleClass="bf-field-lbl"/>
                        <TextArea fx:id="txtComentario" prefRowCount="3" wrapText="true" promptText="¿Qué te pareció?" styleClass="bf-field-input"/>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Label fx:id="lblFeedback" text="" styleClass="bf-field-lbl"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Limpiar" onAction="#onLimpiar" styleClass="bf-btn-secondary"/>
                        <Button text="Publicar" onAction="#onPublicar" styleClass="bf-btn-primary"/>
                    </HBox>
                </VBox>

                <Region prefHeight="32"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beatify.view.controller.PerfilController"
            prefWidth="1280.0"
            prefHeight="800.0">
    <!-- TOPBAR igual que home.fxml -->
    <top>
        <HBox styleClass="bf-topbar" spacing="14" alignment="CENTER_LEFT">
            <HBox spacing="6">
                <Button styleClass="bf-tb-arrow" onAction="#onAtras">
                    <graphic><FontIcon iconLiteral="bi-arrow-left" iconSize="14"/></graphic>
                </Button>
                <Button styleClass="bf-tb-arrow" onAction="#onAdelante">
                    <graphic><FontIcon iconLiteral="bi-arrow-right" iconSize="14"/></graphic>
                </Button>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane>
                <Button fx:id="btnNotif" styleClass="bf-tb-icon">
                    <graphic><FontIcon iconLiteral="bi-bell" iconSize="16"/></graphic>
                </Button>
                <Label fx:id="lblNotifCount" text="5" styleClass="bf-tb-dot" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="2" right="2"/></StackPane.margin>
                </Label>
            </StackPane>

            <Button fx:id="btnUserMenu" styleClass="bf-tb-user" onAction="#onUserMenu">
                <graphic>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <StackPane fx:id="userAvatarHolder"/>
                        <Label fx:id="lblUserNombre" text="Usuario"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- SIDEBAR igual que home.fxml -->
    <left>
        <VBox styleClass="bf-sidebar" prefWidth="240" spacing="2">
            <Label text="PRINCIPAL" styleClass="bf-side-divider"/>
            <Button text="Inicio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrInicio">
                <graphic><FontIcon iconLiteral="bi-house" iconSize="16"/></graphic>
            </Button>
            <Button text="Explorar" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrExplorar">
                <graphic><FontIcon iconLiteral="bi-search" iconSize="16"/></graphic>
            </Button>
            <Button text="Tu biblioteca" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBiblioteca">
                <graphic><FontIcon iconLiteral="bi-collection" iconSize="16"/></graphic>
            </Button>

            <Label text="DIFERENCIADORES" styleClass="bf-side-divider"/>
            <Button text="Reseñas" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrResenas">
                <graphic><FontIcon iconLiteral="bi-star" iconSize="16"/></graphic>
            </Button>
            <Button text="Música del Barrio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBarrio">
                <graphic><FontIcon iconLiteral="bi-geo-alt" iconSize="16"/></graphic>
            </Button>
            <Button text="Cápsulas del Tiempo" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrCapsulas">
                <graphic><FontIcon iconLiteral="bi-clock" iconSize="16"/></graphic>
            </Button>
            <Button text="Logros" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrLogros">
                <graphic><FontIcon iconLiteral="bi-trophy" iconSize="16"/></graphic>
            </Button>

            <HBox styleClass="bf-side-divider" alignment="CENTER_LEFT">
                <Label text="TUS PLAYLISTS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button styleClass="bf-side-plus" onAction="#onNuevaPlaylist">
                    <graphic><FontIcon iconLiteral="bi-plus" iconSize="14"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="sidebarPlaylistsBox" spacing="2"/>
            </ScrollPane>

            <Button text="👤 Perfil" styleClass="bf-side-item, is-active" maxWidth="Infinity" onAction="#onIrPerfil">
                <graphic><FontIcon iconLiteral="bi-person" iconSize="16"/></graphic>
            </Button>

            <Region VBox.vgrow="SOMETIMES" minHeight="8"/>
            <Button text="Cerrar sesión" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onCerrarSesion">
                <graphic><FontIcon iconLiteral="bi-box-arrow-right" iconSize="16"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: -bf-bg; -fx-background: -bf-bg;">
            <VBox styleClass="bf-page" spacing="24">

                <!-- TÍTULO -->
                <Label text="PERFIL" styleClass="bf-section-eyebrow"/>
                <Label text="👤 " styleClass="bf-page-title"/>

                <!-- INFO USUARIO -->
                <HBox spacing="24" alignment="CENTER_LEFT">
                    <StackPane fx:id="avatarHolder" prefWidth="120" prefHeight="120"/>
                    <VBox spacing="8">
                        <Label fx:id="lblNombre" text="Cargando..." styleClass="bf-hero-title" style="-fx-font-size: 28px;"/>
                        <Label fx:id="lblUbicacion" text="📍 Valledupar" styleClass="bf-hero-sub"/>
                        <Label fx:id="lblEmail" text="correo@ejemplo.com" styleClass="bf-hero-sub"/>
                        <Label fx:id="lblPlanBadge" text="PLAN: INDIVIDUAL" styleClass="bf-barrio-tag"/>
                        <Label fx:id="lblMiembroDesde" text="Miembro desde mayo 2026" styleClass="bf-hero-sub"/>
                        <Button fx:id="btnEditarPerfil" text="Editar perfil" styleClass="bf-btn-primary-sm" onAction="#onEditarPerfil"/>
                    </VBox>
                </HBox>

                <!-- ESTADÍSTICAS -->
                <HBox spacing="40" styleClass="bf-card">
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblStatRep" text="1.247" styleClass="bf-hero-stat-num"/>
                        <Label text="REPRODUCCIONES" styleClass="bf-hero-stat-lbl"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblStatLikes" text="89" styleClass="bf-hero-stat-num"/>
                        <Label text="FAVORITOS" styleClass="bf-hero-stat-lbl"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblStatResenas" text="23" styleClass="bf-hero-stat-num"/>
                        <Label text="RESEÑAS" styleClass="bf-hero-stat-lbl"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblStatSiguiendo" text="42" styleClass="bf-hero-stat-num"/>
                        <Label text="SIGUIENDO" styleClass="bf-hero-stat-lbl"/>
                    </VBox>
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="lblStatLogros" text="8 / 24" styleClass="bf-hero-stat-num"/>
                        <Label text="LOGROS" styleClass="bf-hero-stat-lbl"/>
                    </VBox>
                </HBox>

                <!-- SECCIÓN: LOGROS RECIENTES -->
                <VBox spacing="12">
                    <Label text="🏆 Logros recientes" styleClass="bf-section-title"/>
                    <HBox fx:id="logrosRecientesBox" spacing="16"/>
                </VBox>

                <!-- SECCIÓN: CÁPSULAS DEL TIEMPO -->
                <VBox spacing="12">
                    <Label text="⏳ Cápsulas del Tiempo" styleClass="bf-section-title"/>
                    <VBox fx:id="capsulasBox" spacing="8"/>
                </VBox>

                <!-- SECCIÓN: ESCUCHADO RECIENTEMENTE -->
                <VBox spacing="12">
                    <Label text="🎧 Escuchado recientemente" styleClass="bf-section-title"/>
                    <VBox fx:id="recienteBox" spacing="2"/>
                </VBox>

                <Region prefHeight="32"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beatify.view.controller.CatalogoController"
            prefWidth="1280.0"
            prefHeight="800.0">
    <!-- TOPBAR igual que en home.fxml -->
    <top>
        <HBox styleClass="bf-topbar" spacing="14" alignment="CENTER_LEFT">
            <HBox spacing="6">
                <Button styleClass="bf-tb-arrow" onAction="#onAtras">
                    <graphic><FontIcon iconLiteral="bi-arrow-left" iconSize="14"/></graphic>
                </Button>
                <Button styleClass="bf-tb-arrow" onAction="#onAdelante">
                    <graphic><FontIcon iconLiteral="bi-arrow-right" iconSize="14"/></graphic>
                </Button>
            </HBox>

            <HBox styleClass="bf-search" spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="480">
                <FontIcon iconLiteral="bi-search" iconSize="14" iconColor="#8da3bd"/>
                <TextField fx:id="txtBusqueda" styleClass="bf-search-input" promptText="Busca canciones, artistas, álbumes..." HBox.hgrow="ALWAYS"/>
                <Label text="Ctrl+K" styleClass="bf-search-hint"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane>
                <Button fx:id="btnNotif" styleClass="bf-tb-icon">
                    <graphic><FontIcon iconLiteral="bi-bell" iconSize="16"/></graphic>
                </Button>
                <Label fx:id="lblNotifCount" text="5" styleClass="bf-tb-dot" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets top="2" right="2"/></StackPane.margin>
                </Label>
            </StackPane>

            <Button fx:id="btnUserMenu" styleClass="bf-tb-user" onAction="#onUserMenu">
                <graphic>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <StackPane fx:id="userAvatarHolder"/>
                        <Label fx:id="lblUserNombre" text="Usuario"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- SIDEBAR igual que en home.fxml -->
    <left>
        <VBox styleClass="bf-sidebar" prefWidth="240" spacing="2">
            <Label text="PRINCIPAL" styleClass="bf-side-divider"/>
            <Button text="Inicio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrInicio">
                <graphic><FontIcon iconLiteral="bi-house" iconSize="16"/></graphic>
            </Button>
            <Button text="Explorar" styleClass="bf-side-item, is-active" maxWidth="Infinity" onAction="#onIrExplorar">
                <graphic><FontIcon iconLiteral="bi-search" iconSize="16"/></graphic>
            </Button>
            <Button text="Tu biblioteca" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBiblioteca">
                <graphic><FontIcon iconLiteral="bi-collection" iconSize="16"/></graphic>
            </Button>

            <Label text="DIFERENCIADORES" styleClass="bf-side-divider"/>
            <Button text="Reseñas" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrResenas">
                <graphic><FontIcon iconLiteral="bi-star" iconSize="16"/></graphic>
            </Button>
            <Button text="Música del Barrio" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrBarrio">
                <graphic><FontIcon iconLiteral="bi-geo-alt" iconSize="16"/></graphic>
            </Button>
            <Button text="Cápsulas del Tiempo" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrCapsulas">
                <graphic><FontIcon iconLiteral="bi-clock" iconSize="16"/></graphic>
            </Button>
            <Button text="Logros" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onIrLogros">
                <graphic><FontIcon iconLiteral="bi-trophy" iconSize="16"/></graphic>
            </Button>

            <HBox styleClass="bf-side-divider" alignment="CENTER_LEFT">
                <Label text="TUS PLAYLISTS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button styleClass="bf-side-plus" onAction="#onNuevaPlaylist">
                    <graphic><FontIcon iconLiteral="bi-plus" iconSize="14"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="sidebarPlaylistsBox" spacing="2"/>
            </ScrollPane>

            <Region VBox.vgrow="SOMETIMES" minHeight="8"/>
            <Button text="Cerrar sesión" styleClass="bf-side-item" maxWidth="Infinity" onAction="#onCerrarSesion">
                <graphic><FontIcon iconLiteral="bi-box-arrow-right" iconSize="16"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: -bf-bg; -fx-background: -bf-bg;">
            <VBox styleClass="bf-page" spacing="28">

                <!-- HEADER -->
                <VBox spacing="8">
                    <Label text="EXPLORAR" styleClass="bf-section-eyebrow"/>
                    <Label text="Catálogo completo" styleClass="bf-page-title"/>
                </VBox>

                <!-- FILTROS CHIPS -->
                <FlowPane fx:id="filtrosPane" hgap="10" vgap="10"/>

                <!-- ORDEN -->
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label text="Ordenar por:" styleClass="bf-field-lbl"/>
                    <ComboBox fx:id="cmbOrden" styleClass="bf-field-input" prefWidth="140"/>
                </HBox>

                <!-- GÉNEROS RAÍZ (tarjetas grandes) -->
                <VBox spacing="12">
                    <Label text="GÉNEROS RAÍZ" styleClass="bf-section-eyebrow"/>
                    <Label text="Navega por raíz cultural" styleClass="bf-section-title"/>
                    <FlowPane fx:id="generosPane" hgap="16" vgap="16"/>
                </VBox>

                <!-- ÁLBUMES DESTACADOS -->
                <VBox spacing="12">
                    <HBox alignment="BASELINE_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="ÁLBUMES" styleClass="bf-section-eyebrow"/>
                            <Label text="Álbumes destacados" styleClass="bf-section-title"/>
                        </VBox>
                        <Button text="Ver todo →" styleClass="bf-section-action" onAction="#onVerTodosAlbumes"/>
                    </HBox>
                    <GridPane fx:id="albumesGrid" hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="16.66"/>
                            <ColumnConstraints percentWidth="16.66"/>
                            <ColumnConstraints percentWidth="16.66"/>
                            <ColumnConstraints percentWidth="16.66"/>
                            <ColumnConstraints percentWidth="16.66"/>
                            <ColumnConstraints percentWidth="16.66"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <!-- TRACKLIST DE CANCIONES -->
                <VBox spacing="12">
                    <Label text="TODAS LAS CANCIONES" styleClass="bf-section-eyebrow"/>
                    <Label text="Canciones" styleClass="bf-section-title"/>
                    <VBox fx:id="tracklistBox" spacing="2"/>
                </VBox>

                <Region prefHeight="32"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
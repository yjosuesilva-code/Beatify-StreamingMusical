<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    recuperar.fxml — Recuperación de contraseña con verificación por correo.
    Paso 1: ingresar correo → enviar código.
    Paso 2: ingresar código recibido + nueva contraseña → cambiar.
    Controller: com.beatify.view.controller.RecuperarController
-->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.beatify.view.controller.RecuperarController"
           prefWidth="1280.0" prefHeight="800.0"
           styleClass="bf-auth-form-wrap">

    <VBox alignment="TOP_CENTER" spacing="20" maxWidth="460" prefWidth="460">
        <padding><Insets top="80" right="40" bottom="40" left="40"/></padding>

        <!-- Brand -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <StackPane styleClass="bf-brand-logo" prefWidth="56" prefHeight="56">
                <Group>
                    <Circle centerX="22" centerY="22" radius="20" stroke="#1ed760" strokeWidth="1.8" fill="transparent"/>
                    <Circle centerX="22" centerY="22" radius="6" fill="#1ed760"/>
                    <SVGPath content="M22 4 L22 16 M22 28 L22 40 M4 22 L16 22 M28 22 L40 22"
                             stroke="#1ed760" strokeWidth="1.8" strokeLineCap="ROUND" fill="transparent"/>
                </Group>
            </StackPane>
            <Label text="Beatify" styleClass="bf-brand-name"/>
        </HBox>

        <!-- Header -->
        <VBox spacing="6">
            <Label text="RECUPERAR ACCESO" styleClass="bf-auth-step"/>
            <Label text="¿Olvidaste tu contraseña?" styleClass="bf-auth-form-title"/>
            <Label fx:id="lblSub" styleClass="bf-auth-form-sub" wrapText="true"
                   text="Ingresa tu correo y te enviaremos un código para verificar que eres tú."/>
        </VBox>

        <!-- Banner feedback / error -->
        <VBox fx:id="boxError" styleClass="bf-auth-error" spacing="4" visible="false" managed="false">
            <Label fx:id="lblErrorCode" text="" styleClass="bf-auth-error-code"/>
            <Label fx:id="lblErrorMsg"  text="" styleClass="bf-auth-error-msg" wrapText="true"/>
        </VBox>

        <!-- PASO 1: correo -->
        <VBox fx:id="paso1" spacing="14">
            <VBox spacing="6">
                <Label text="Correo electrónico" styleClass="bf-field-lbl"/>
                <TextField fx:id="txtCorreo" promptText="tu@correo.com" styleClass="bf-field-input"/>
            </VBox>
            <Button fx:id="btnEnviar" text="Enviar código" styleClass="bf-btn-primary"
                    maxWidth="Infinity" onAction="#onEnviarCodigo"/>
        </VBox>

        <!-- PASO 2: código + nueva contraseña (oculto hasta enviar) -->
        <VBox fx:id="paso2" spacing="14" visible="false" managed="false">
            <VBox spacing="6">
                <Label text="Código de verificación" styleClass="bf-field-lbl"/>
                <TextField fx:id="txtCodigo" promptText="000000" styleClass="bf-field-input"/>
                <Label text="Revisa tu correo (y la carpeta de spam)." styleClass="bf-field-hint"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Nueva contraseña" styleClass="bf-field-lbl"/>
                <PasswordField fx:id="txtNueva" promptText="Mínimo 6 caracteres" styleClass="bf-field-input"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Confirmar contraseña" styleClass="bf-field-lbl"/>
                <PasswordField fx:id="txtConfirma" promptText="Repite la nueva contraseña" styleClass="bf-field-input"/>
            </VBox>
            <HBox spacing="10">
                <Button fx:id="btnReenviar" text="Reenviar código" styleClass="bf-btn-ghost" onAction="#onEnviarCodigo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCambiar" text="Cambiar contraseña" styleClass="bf-btn-primary" onAction="#onCambiar"/>
            </HBox>
        </VBox>

        <Region prefHeight="6"/>

        <!-- Volver al login -->
        <HBox alignment="CENTER" spacing="6">
            <FontIcon iconLiteral="bi-arrow-left" iconSize="13" iconColor="#a7a7a7"/>
            <Hyperlink fx:id="linkVolver" text="Volver a iniciar sesión"
                       styleClass="bf-auth-switch-link" onAction="#onVolver"/>
        </HBox>
    </VBox>
</StackPane>
